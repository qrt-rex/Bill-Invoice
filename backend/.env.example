# Billing database. MUST be a separate database from the main CRM/HR one.
# Production: postgresql+psycopg://USER:PASSWORD@HOST:5432/rexera_billing?sslmode=require
DATABASE_URL=sqlite:///./billing.db

# Main application API used for sign-in and to verify every billing request's token.
MAIN_API_URL=http://localhost:8000
IDENTITY_CACHE_SECONDS=60

# Origins allowed to call this API (the billing frontend).
CORS_ORIGINS=["http://localhost:5190"]
RATE_LIMIT_PER_MINUTE=300
MAX_UPLOAD_MB=15
